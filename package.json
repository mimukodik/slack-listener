{
  "name": "slack-listener-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "pnpm fmt:check && pnpm -r lint && pnpm -r typecheck",
    "test": "pnpm -r test",
    "sim": "pnpm --filter @muhely/slack-listener sim",
    "exhaustive": "pnpm --filter @muhely/slack-listener exhaustive"
  },
  "devDependencies": {
    "oxfmt": "0.56.0",
    "oxlint": "1.90.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.17.0"
}

{
  "name": "slack-listener",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude Code channel server that pushes new messages from one Slack channel into a session, quoted as data.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimukodik/slack-listener.git"
  },
  "bin": {
    "slack-listener": "src/main.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "bun run fmt:check && effect-tsgo --tsrs-lint oxlint --type-aware --type-check --tsconfig tsconfig.json --format=unix --deny-warnings src",
    "test": "bun test",
    "sim": "bun src/sim/run.ts",
    "exhaustive": "bun src/sim/exhaustive.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.4",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.70.0",
    "@types/bun": "1.4.5",
    "@types/node": "^26.6.6",
    "fast-check": "4.10.2",
    "oxfmt": "0.56.0",
    "oxlint": "1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5"
}

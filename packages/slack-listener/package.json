{
  "name": "@muhely/slack-listener",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code channel server that pushes new messages from one Slack channel into a session.",
  "bin": {
    "slack-listener": "src/main.ts"
  },
  "type": "module",
  "scripts": {
    "lint": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsrs-lint oxlint --config ../../.oxlintrc.json --tsconfig tsconfig.json --format=unix --deny-warnings src",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "sim": "node src/sim/run.ts",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "4.10.2",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "agent-native": {
    "layer": "foundation"
  }
}

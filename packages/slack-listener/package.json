{
  "name": "@muhely/slack-listener",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code channel server that pushes new messages from one Slack channel into a session.",
  "bin": {
    "slack-listener": "src/main.ts"
  },
  "type": "module",
  "scripts": {
    "lint": "node ../../scripts/lint-source.ts --project --deny-warnings",
    "typecheck": "tsc --noEmit --checkers 1 -p tsconfig.json",
    "guard:no-default-chrome": "node ../../scripts/guard-no-default-chrome.mjs --package .",
    "guard:no-heavy-dashboard-list-reads": "node ../../scripts/guard-no-heavy-dashboard-list-reads.mjs --package .",
    "guard:no-boot-data-work": "node ../../scripts/guard-no-boot-data-work.mjs --package .",
    "guard:no-blob-column-predicate": "node ../../scripts/guard-no-blob-column-predicate.mjs --package .",
    "guard:no-legacy-config": "node ../../scripts/guard-no-legacy-config.mjs --package .",
    "guard:no-silent-coercion": "node ../../scripts/guard-no-silent-coercion.mjs --package .",
    "guard:no-raw-colors": "node ../../scripts/guard-no-raw-colors.mjs --package .",
    "guard:no-comments": "node ../../scripts/guard-no-comments.mjs --package .",
    "guard:no-core-client-barrel-imports": "node --experimental-strip-types ../../scripts/guard-no-core-client-barrel-imports.ts --package .",
    "guard:request-storms": "node --experimental-strip-types ../../scripts/guard-request-storms.ts --package .",
    "guard:help-icon-scale": "node ../../scripts/guard-help-icon-scale.mjs --package .",
    "test": "vitest --run",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@muhely/tsc": "workspace:*",
    "@types/node": "^26.6.6",
    "fast-check": "4.10.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "agent-native": {
    "layer": "foundation"
  }
}
